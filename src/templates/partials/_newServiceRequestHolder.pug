.page-padding
    include ../partials/_breadCrumb
    include ../partials/_newServiceRequest
    if page == "create-performance-evaluation-form"
        .modal#leaveModal(tabindex="-1").leaveModal
            .modal-dialog.modal-dialog-centered
                .modal-content
                    .modal-body.d-flex.justify-content-center.flex-column.align-items-center
                        .modalLoader.text-center
                            .spinner-border(role='status')
                            p.mt-2 Please wait...
                        .successWrapper.d-flex.align-items-center.justify-content-center.flex-column.d-none
                            lottie-player#successAnim(
                                        src="assets/images/success.json"
                                        background="transparent"
                                        speed="1"
                                        style="width:150px; height:150px;"
                                    )
                            h5.modal-title.fw-900 Form Submitted
                        .failureWrapper.d-flex.align-items-center.justify-content-center.flex-column.d-none
                            lottie-player#successAnim(
                                        src="assets/images/failure.json"
                                        background="transparent"
                                        speed="1"
                                        style="width:120px; height:120px;"
                                    )
                            h5.modal-title.fw-900 Request Rejected
                        //- img(src="assets/images/success.gif" alt="success")
                        //- .video-container(style="width: 100%; max-width: 600px;")
                        //-     video.tickVideo(autoplay muted loop playsinline style="width:150px; height:150px; display:block; margin:auto;")
                        //-         source(src="assets/videos/success-apply-leave.mp4" type="video/mp4")
                        //- h5.modal-title.fw-900 Request Submitted
                    .modal-footer
                        button.btn.btn-blue.rounded-pill(type="button" data-bs-dismiss="modal").fw-900 Done 
    
    .modal#leaveModal(tabindex="-1").leaveModal
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-body.d-flex.justify-content-center.flex-column.align-items-center
                    .modalLoader.text-center
                        .spinner-border(role='status')
                        p.mt-2 Please wait...
                    .successWrapper.d-flex.align-items-center.justify-content-center.flex-column.d-none
                        lottie-player#successAnim(
                                    src="assets/images/success.json"
                                    background="transparent"
                                    speed="1"
                                    style="width:150px; height:150px;"
                                )
                        h5.modal-title.fw-900 Request Submitted
                    .failureWrapper.d-flex.align-items-center.justify-content-center.flex-column.d-none
                        lottie-player#successAnim(
                                    src="assets/images/failure.json"
                                    background="transparent"
                                    speed="1"
                                    style="width:120px; height:120px;"
                                )
                        h5.modal-title.fw-900 Request Rejected
                    //- img(src="assets/images/success.gif" alt="success")
                    //- .video-container(style="width: 100%; max-width: 600px;")
                    //-     video.tickVideo(autoplay muted loop playsinline style="width:150px; height:150px; display:block; margin:auto;")
                    //-         source(src="assets/videos/success-apply-leave.mp4" type="video/mp4")
                    //- h5.modal-title.fw-900 Request Submitted
                .modal-footer
                    button.btn.btn-blue.rounded-pill(type="button" data-bs-dismiss="modal").fw-900 Done 
   
    include ../partials/_footer
    script(src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js")
    script(src="assets/js/videoloop.js")
if page == "create-performance-evaluation-form"
    script(src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js")
    script(src="assets/js/videoloop.js")
   

