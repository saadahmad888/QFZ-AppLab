
button.btn.btn-primary(
  data-bs-toggle="modal",
  data-bs-target="#businessCardModal"
) View Business Card

//- Modal
div.modal.fade#businessCardModal.modal-slide-up(tabindex="-1", aria-hidden="true")
  div.modal-dialog.modal-dialog-centered.modal-lg
    div.modal-content.radius-16.bg-white

      //- Modal Header
      .modal-header.border-0.pb-2
        h2.fw-500.fs-24.text-black2.mb-0 E Business Card
        button.btn-close(
          type="button",
          data-bs-dismiss="modal",
          aria-label="Close"
        )

      //- Modal Body
      .modal-body.p-24

        .business-card-holder.radius-16.bg-white.box-3

          .card-wrapper.radius-16

            .d-flex.justify-content-between.align-items-center
              img.logo-card.img-fluid(
                src="assets/images/logo-black.svg",
                height="110",
                width="259",
                alt="Logo"
              )
              .cardHolder-name
                p.fs-20.text-blue.mb-0.text-end AHMAD SALEEM AHMAD SALEEM AHMAD SALEEM
                p.fs-18.text-black.mb-0.text-end MARKETING MARKETING 

            .d-flex.justify-content-between.align-items-center.mt-3
              img.qr-code.img-fluid(
                src="assets/images/blueQR-code.svg",
                height="140",
                width="140",
                alt="QR Code"
              )
              .cardHolder-name.info-modal
                p.fs-18.text-black.mb-0.text-end.opc-80 +974 4020 5020
                p.fs-18.text-black.mb-0.text-end.opc-80.break-text info@qfz.qa
              span.blue-line.blue-line-modal
