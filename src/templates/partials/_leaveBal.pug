
.leave-balances.min-h-100.box-3.p-24 
    .leaves-section.d-flex.flex-column.gap-4
        .leave-bal-heading
            .d-flex.flex-column
                h2.mb-3.fs-24 Leave Balances
                p.fs-16.mb-0 2025 Overview
        .leave-names.d-flex.flex-column.gap-5 
            .annual-leave 
                .d-flex.gap-3.align-items-start
                    .d-flex.flex-shrink
                        i.size-24.bg-blue(style="-webkit-mask-image:url(assets/images/calender.svg);-wekkit-mask-repeat:no-repeat")
                    .d-flex.flex-column.flex-grow.w-100
                        .row
                            .col
                                h3.mb-0.fs-18 Annual Leaves
                            .col-auto
                                .fs-18
                                    span.fw-900.opc-60.used(data-used="05") 05 /
                                    span.fw-350.opc-60.total(data-total="30") &nbsp;30 

                        .progress(role="progressbar", aria-label="", aria-valuenow="0", aria-valuemin="0", aria-valuemax="100")
                            .progress-bar.bg-blue(style="width: 0%;")

            .sick-leave 
                .d-flex.gap-3.align-items-start
                    .d-flex.flex-shrink
                        i.size-24.bg-green(style="-webkit-mask-image:url(assets/images/sethoscope.svg);-wekkit-mask-repeat:no-repeat")
                    .d-flex.flex-column.flex-grow.w-100
                        .row 
                            .col
                                h3.mb-0.fs-18 Sick Leaves
                            .col-auto 
                                .fs-18 
                                    span.fw-900.opc-60.used(data-used="00") 00 /
                                    span.fw-350.opc-60.total(data-total="06") &nbsp;06 

                        .progress(role="progressbar", aria-label="", aria-valuenow="0", aria-valuemin="0", aria-valuemax="100")
                            .progress-bar.bg-green 
            .casual-leave 
                .d-flex.gap-3.align-items-start
                    .d-flex.flex-shrink
                        i.size-24.bg-secondary(style="-webkit-mask-image:url(assets/images/clock.svg);-wekkit-mask-repeat:no-repeat")
                    .d-flex.flex-column.flex-grow.w-100
                        .row 
                            .col
                                h3.mb-0.fs-18 Casual Leaves
                            .col-auto 
                                .fs-18 
                                    span.fw-900.opc-60.used(data-used="2") 02 / 
                                    span.fw-350.opc-60.total(data-total="12") &nbsp;12 

                        .progress(role="progressbar", aria-label="Basic example", aria-valuenow="75", aria-valuemin="0", aria-valuemax="100")
                            .progress-bar.bg-secondary(style="width: 0%;")   

        
