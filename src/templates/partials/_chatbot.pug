.chatbot-container
    button.border-0.bg-transparent(type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasChatbot" aria-controls="offcanvasChatbot")
        img(src="assets/images/chatbot-icon.svg").img-fluid.main-chat-logo
    .offcanvas.offcanvas-end.chatbot-offcanvas(tabindex='-1', id='offcanvasChatbot', aria-labelledby='offcanvasChatbotLabel'  data-bs-backdrop="static"
     data-bs-keyboard="false")
        .offcanvas-header
            h5.offcanvas-title#offcanvasChatbotLabel 
            .d-flex.offcanvas-btn-wrap 
                button.btn-mimimise(type='button', aria-label='')
                button.btn-close(type='button', data-bs-dismiss='offcanvas', aria-label='Close')
            
        .offcanvas-body.pt-0
            .welcome-msg
                img(src="assets/images/chatbot-icon.svg" width="80" height="76").img-fluid.mb-64
                h6.fw-350.opc-80.fs-24.mb-24 Welcome back! 
                    span.fw-900 Yousef Al-Mansour
                h1.fs-40.mb-56 How may I help you today?
                button.get-started-btn.btn.fs-18 Get Started
                .continue-msg
                    .d-flex.align-items-center
                        i.d-inline-flex(style="background:url(assets/images/suggestion-container.svg) center no-repeat;width:50px;height:50px;background-size:50px;")
                        h6.fs-16.fw-500 Terms and Conditions
                        
                    p.fw-350.fs-16 Qatar Free Zones Authority (QFZ) does not warrant the accuracy, reliability or completeness of any information provided by the QFZ Chatbot and assumes no liability or responsibility whatsoever for any errors or omissions in such information. The use of the QFZ Chatbot is at your own risk. The information you input into the QFZ Chatbot will be logged, stored, and used for quality and training purposes. Any personal information or confidential data inputted will be at your own risk; using personal information or confidential data should be avoided.
                    button.accept-continue-btn.btn.fs-18.fw-500 Accept and Continue
