.request-overview-holder.box-1.p-24    
    .d-flex.flex-column.h-100 
        h2.fw-500.fs-24.text-black2.mb-32 Request Overview 
        .row
            .col-xl-6.mt-4.mt-xl-0  
                a(href="quick-links-pending-requests.html")
                    .request-box.bg-lightYellow.d-flex.align-items-center.justify-content-between 
                        .content 
                            h2.fs-24.fw-900.mb-0 04
                            p.fs-16.fw-300.mb-0 Requests Pending 
                        .icon 
                            img(src="assets/images/request-pending.svg" height="39" width="31").img-fluid
            .col-xl-6.mt-4.mt-xl-0 
                a(href="quick-links-approved-requests.html")
                    .request-box.bg-lightGreen.d-flex.align-items-center.justify-content-between 
                        .content 
                            h2.fs-24.fw-900.mb-0 16
                            p.fs-16.fw-300.mb-0 Requests Approved 
                        .icon 
                            img(src="assets/images/request-approved.svg" height="39" width="31").img-fluid
            .col-xl-6.mt-4 
                a(href="quick-links-rejected-requests.html")
                    .request-box.bg-lightRed.d-flex.align-items-center.justify-content-between 
                        .content 
                            h2.fs-24.fw-900.mb-0 05
                            p.fs-16.fw-300.mb-0 Requests Rejected 
                        .icon 
                            img(src="assets/images/request-rejected.svg" height="39" width="31").img-fluid
