.login-wrapper
    .radius-32.bg-grey3.container-lg.p-0.login-holder
        .row.radius-16.overflow-hidden.g-0.h-100
            .col-lg-6 
                .login-box.gy-32.d-flex.flex-column
                    .d-flex
                        img(src="assets/images/logo-black.svg").img-fluid
                    .d-flex.gy-12.flex-column
                        h2.mb-0.fw-500.fs-32 Sign In with Microsoft 
                        p.mb-0.fw-350.fs-16.text-black1.opc-60 Welcome to QFZ Employee Self-Service Portal
                    .d-flex.gy-12.flex-column.login-form
                    //-    form
                        .mb-3.form-group.position-relative    
                            input.form-control.radius-12(type="email" placeholder="Email Address" aria-describedby="email")
                            span.d-block.email-icon
                                i.size-24.bg-blue.d-inline-block(style="-webkit-mask-image:url('assets/images/email-icon-login.svg');-webkit-mask-repeat:no-repeat;-webkit-mask-position: center;")
                        .mb-3.form-group.position-relative    
                            input.form-control.radius-12(type="password" placeholder="Password" aria-describedby="pwd")
                            span.d-block.pwd-icon
                                i.size-24.bg-blue.d-inline-block(style="-webkit-mask-image:url('assets/images/pwd-icon-login.svg');-webkit-mask-repeat:no-repeat;-webkit-mask-position: center;")

                    button.btn.btn-white.text-black1.fw-500.fs-18(type="submit").p-2.p-lg-3.rounded-pill.align-items-center.d-flex.justify-content-center.gx-12 
                        i.size-24.d-inline-block(style="background-image:url(assets/images/microsoft-logo.svg);background-repeat: no-repeat")
                        span Sign in with Microsoft
            .col-lg-6
                .login-section-end.login-base-image.h-100
                    img.img-fluid.w-100.h-100(src="assets/images/loginpage-image6.jpg", alt="Slide 4")
                    //- .carousel.slide.carousel-fade(data-bs-ride="carousel" data-bs-interval="3000" id="loginCarousel").h-100
                        .carousel-inner.h-100
                            .carousel-item.active.h-100
                                img.img-fluid.w-100.h-100(src="assets/images/loginpage-image1.jpg", alt="Slide 1")
                            .carousel-item.h-100
                                img.img-fluid.w-100.h-100(src="assets/images/loginpage-image2.jpg", alt="Slide 2")
                            .carousel-item.h-100
                                img.img-fluid.w-100.h-100(src="assets/images/loginpage-image3.jpg", alt="Slide 3")
                            .carousel-item.h-100
                                img.img-fluid.w-100.h-100(src="assets/images/loginpage-image4.jpg", alt="Slide 4")

                    img(src="assets/images/logo-white.svg").login-top-image




                                        