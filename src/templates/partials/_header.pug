header.header.bg-grey4
    .container-fluid
        .d-flex.justify-content-between 
            img(src="assets/images/logo-black.svg").img-fluid.main-logo
            .d-flex.gap-2.gap-lg-3.align-items-center
                a.inline-block.pending-approvals-btn.position-relative(href="#") 
                    span.rounded-pill.badge-pending-approvals 7
                        span.visually-hidden unread msg
                    span.d-inline-flex
                        i.size-28.d-inline-block(style="background:url(assets/images/checklist-header.svg) center no-repeat")
                button.btn.btn-white.notification-btn.py-10.position-relative(
                    type="button",
                    data-bs-toggle="offcanvas",
                    data-bs-target="#notification",
                    aria-controls="notification")
                    span.rounded-pill.badge-notification 7
                        span.visually-hidden unread msg
                    span.d-inline-flex
                        i.size-28.d-inline-block(style="background:url(assets/images/notification-bell.svg) center no-repeat")
                .offcanvas.offcanvas-end.notification-canvas( tabindex="-1", id="notification",aria-labelledby="notificationLabel")
                    .offcanvas-header
                        //- h5.offcanvas-title#offcanvasExampleLabel Offcanvas
                        button.btn-close(type="button", data-bs-dismiss="offcanvas", aria-label="Close")
                    .offcanvas-body
                        h1.fs-40.offcanvas-title Notification
                        p.fs-20.text-black-light.mb-3 You have <span class="fw-900">3</span> new notifications
                        form.d-flex(role="search").form-request.mb-3.w-100
                            input.form-control.rounded-pill.pe-5.w-100(type="search" placeholder="Search Request ID..." aria-label="Search")
                            span.bg-blue.search-btn.d-flex.align-items-center.justify-content-center
                                i.search-icon.d-inline-flex(style="-webkit-mask:url('assets/images/search-icon.svg') center no-repeat;") 

                        .notification-holder
                            .notification-details.d-flex.justify-content-between.mb-32
                                .div.d-flex.gap-3   
                                    .read-box Unread
                                    .unread-box Read
                                .filter-box Filter
                                    i.size-28.d-inline-block(style="background:url(assets/images/sort.svg) center no-repeat")
                            .notification-list 
                                .box-unread
                                    h6.fs-16.fw-900.heading Leave Request Approved
                                    p.fs-14.fw-350.reason Your leave request from Sep 20–23 was approved by<span class="fw-900 text-black-light"> Manager Ali.</span>
                                    p.fs-14.fw-350.time  2 minutes ago
                                    .status-approved 
                                        i.size-28.d-inline-block(style="background:url(assets/images/tick.svg) center no-repeat")
                                .box-unread
                                    h6.fs-16.fw-900.heading All-Staff Meeting
                                    p.fs-14.fw-350.reason Don’t forget: All-hands staff meeting today at 2:00 PM.
                                    p.fs-14.fw-350.time  5 minutes ago
